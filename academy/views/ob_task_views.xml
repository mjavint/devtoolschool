<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View task View List -->
    <record id="view_task_list"
        model="ir.ui.view">
        <field name="name">view.task.list</field>
        <field name="model">ob.task</field>
        <field name="arch"
            type="xml">
            <list>
                <field name="name" />
                <field name="duration" />
            </list>
        </field>
    </record>

    <!-- View task form -->
    <record id="view_task_form"
        model="ir.ui.view">
        <field name="name">view.task.form</field>
        <field name="model">ob.task</field>
        <field name="arch"
            type="xml">
            <form string="Task">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name"
                                placeholder="Name..." />
                        </h1>
                    </div>
                    <group>
                        <field name="duration"
                            widget="literal_time_float"
                            placeholder="Duración, Ejemplo: 1h 30m" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action task -->
    <record id="action_task"
        model="ir.actions.act_window">
        <field name="name">Task</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ob.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help"
            type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Task.
            </p>
        </field>
    </record>

    <menuitem id="menu_task_root"
        name="Task" />
    <menuitem id="menu_task_sub"
        name="Tasks"
        parent="menu_task_root"
        action="action_task" />

</odoo>
